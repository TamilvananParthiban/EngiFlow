# ============================================================
# IT Operations Manager - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Application
NODE_ENV=development
APP_NAME=IT Operations Manager
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Server
PORT=3001

# Database
DATABASE_URL="mysql://itops:itops_password@localhost:3306/it_operations_db"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=it_operations_db
DB_USER=itops
DB_PASSWORD=itops_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=IT Operations Manager <noreply@company.com>

# Notifications (future integrations)
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
# TEAMS_WEBHOOK_URL=
# SMS_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Docker (used in docker-compose)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=it_operations_db
MYSQL_USER=itops
MYSQL_PASSWORD=itops_password
