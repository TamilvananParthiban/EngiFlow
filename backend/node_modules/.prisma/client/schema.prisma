// ============================================================
// IT Operations Manager — Prisma Schema
// Database: MySQL 8 / MariaDB 10.6+
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  IT_MANAGER
  SYSTEM_ADMIN
  IT_ENGINEER
  IT_SUPPORT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_VENDOR
  WAITING_FOR_USER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  INTERNET
  SERVER
  PRINTER
  CCTV
  SECURITY
  BACKUP
  USER_ACCESS
  EMAIL
  OTHER
}

enum AssetStatus {
  ACTIVE
  IN_STOCK
  ASSIGNED
  UNDER_MAINTENANCE
  REPAIR
  LOST
  RETIRED
  DISPOSED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetType {
  LAPTOP
  DESKTOP
  SERVER
  PRINTER
  NETWORK_SWITCH
  ROUTER
  FIREWALL
  ACCESS_POINT
  CCTV_CAMERA
  NVR
  UPS
  STORAGE
  MONITOR
  SCANNER
  OTHER
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum VendorType {
  LAPTOP_RENTAL
  INTERNET
  AMC
  HARDWARE
  NETWORK
  CCTV
  PRINTER
  SOFTWARE
  CLOUD
  BACKUP
  SECURITY
  ELECTRICAL
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVAL_PENDING
  APPROVED
  PAYMENT_PENDING
  PAID
  OVERDUE
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PENDING
  WAITING_FOR_VENDOR
  WAITING_FOR_APPROVAL
  CANCELLED
}

enum ActivityCategory {
  SYSTEM_ADMINISTRATION
  NETWORK
  SERVER
  BACKUP
  SECURITY
  HARDWARE
  SOFTWARE
  CCTV
  INTERNET
  VENDOR
  PURCHASE
  AMC
  USER_SUPPORT
  DOCUMENTATION
  MEETING
  MONITORING
  PREVENTIVE_MAINTENANCE
}

enum PMStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum PMFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum BackupStatus {
  SUCCESSFUL
  FAILED
  WARNING
  NOT_RUN
}

enum CCTVStatus {
  ONLINE
  OFFLINE
  FAULT
  UNDER_MAINTENANCE
}

enum PurchaseStatus {
  REQUEST
  QUOTATION
  APPROVAL
  PURCHASE_ORDER
  DELIVERY
  INVOICE
  PAYMENT
  COMPLETED
  REJECTED
  CANCELLED
}

enum FollowupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommunicationType {
  PHONE
  EMAIL
  WHATSAPP
  MEETING
  PORTAL
}

enum NetworkDeviceType {
  ROUTER
  SWITCH
  FIREWALL
  ACCESS_POINT
  MODEM
  SERVER
  UPS
  OTHER
}

enum NetworkStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
}

enum ISPConnectionType {
  FIBER
  BROADBAND
  LEASED_LINE
  WIRELESS
  VSAT
  MPLS
  SD_WAN
}

enum AMCRenewalStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RENEWED
  CANCELLED
}

enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  VOLUME
  OEM
  OPEN_SOURCE
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  EXPIRING_SOON
  SUSPENDED
}

enum WarrantyType {
  COMPREHENSIVE
  ONSITE
  CARRY_IN
  EXTENDED
  AMC
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  EXPIRING_SOON
  CLAIMED
}

enum RentalPaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  PAYMENT_DUE
  AMC_EXPIRING
  WARRANTY_EXPIRING
  LICENSE_EXPIRING
  PM_DUE
  FOLLOWUP_DUE
  FOLLOWUP_OVERDUE
  BACKUP_FAILED
  NETWORK_OUTAGE
  GENERAL
}

// ============================================================
// CORE TABLES
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  headUserId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  assets     Asset[]
  tickets    Ticket[]
  activities Activity[]
  tasks      Task[]
  purchases  PurchaseRequest[]

  @@map("departments")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  floor     String?
  building  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets         Asset[]
  networkDevices NetworkDevice[]
  cctvCameras    CCTVCamera[]
  nvrDevices     NVRDevice[]
  ispConnections ISPConnection[]

  @@map("locations")
}

model User {
  id           String     @id @default(cuid())
  employeeId   String?    @unique
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(IT_SUPPORT)
  status       UserStatus @default(ACTIVE)
  phone        String?
  designation  String?
  avatar       String?
  departmentId String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  department         Department?             @relation(fields: [departmentId], references: [id])
  refreshTokens      RefreshToken[]
  assignedAssets     Asset[]                 @relation("AssignedUser")
  createdActivities  Activity[]              @relation("ActivityCreator")
  assignedTasks      Task[]                  @relation("TaskAssignee")
  createdTasks       Task[]                  @relation("TaskCreator")
  assignedTickets    Ticket[]                @relation("TicketEngineer")
  reportedTickets    Ticket[]                @relation("TicketReporter")
  pmEngineers        PreventiveMaintenance[] @relation("PMEngineer")
  licenseAssignments LicenseAssignment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  followups          Followup[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// VENDOR MANAGEMENT
// ============================================================

model Vendor {
  id            String       @id @default(cuid())
  vendorCode    String       @unique
  name          String
  type          VendorType
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  panNumber     String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  services      String?
  contractStart DateTime?
  contractEnd   DateTime?
  sla           String?
  status        VendorStatus @default(ACTIVE)
  remarks       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  contacts       VendorContact[]
  contracts      VendorContract[]
  assets         Asset[]
  invoices       Invoice[]
  payments       Payment[]
  tickets        Ticket[]
  amcContracts   AMCContract[]
  ispConnections ISPConnection[]
  activities     Activity[]
  tasks          Task[]
  followups      Followup[]
  laptopRentals  LaptopRental[]
  licenses       SoftwareLicense[]
  warranties     Warranty[]
  expenses       Expense[]
  purchases      PurchaseRequest[]

  @@index([type])
  @@index([status])
  @@map("vendors")
}

model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  title     String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contacts")
}

model VendorContract {
  id             String   @id @default(cuid())
  vendorId       String
  contractNumber String
  title          String
  startDate      DateTime
  endDate        DateTime
  value          Decimal
  terms          String?
  status         String   @default("ACTIVE")
  documentUrl    String?
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contracts")
}

// ============================================================
// ASSET MANAGEMENT
// ============================================================

model Asset {
  id              String         @id @default(cuid())
  assetCode       String         @unique
  type            AssetType
  brand           String?
  model           String?
  serialNumber    String?
  purchaseDate    DateTime?
  purchaseCost    Decimal?
  vendorId        String?
  warrantyStart   DateTime?
  warrantyEnd     DateTime?
  assignedUserId  String?
  departmentId    String?
  locationId      String?
  ipAddress       String?
  macAddress      String?
  hostname        String?
  operatingSystem String?
  status          AssetStatus    @default(ACTIVE)
  condition       AssetCondition @default(GOOD)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  remarks         String?        @db.Text
  qrCode          String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  vendor        Vendor?                 @relation(fields: [vendorId], references: [id])
  assignedUser  User?                   @relation("AssignedUser", fields: [assignedUserId], references: [id])
  department    Department?             @relation(fields: [departmentId], references: [id])
  location      Location?               @relation(fields: [locationId], references: [id])
  history       AssetHistory[]
  tickets       Ticket[]
  activities    Activity[]
  tasks         Task[]
  followups     Followup[]
  maintenance   PreventiveMaintenance[]
  amcContracts  AMCContract[]           @relation("AMCAssets")
  warranty      Warranty?
  laptopRentals LaptopRental[]

  @@index([type])
  @@index([status])
  @@index([assignedUserId])
  @@index([departmentId])
  @@map("assets")
}

model AssetHistory {
  id          String   @id @default(cuid())
  assetId     String
  action      String
  description String
  oldValue    String?
  newValue    String?
  performedBy String?
  performedAt DateTime @default(now())
  ticketId    String?
  createdAt   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_history")
}

// ============================================================
// ACTIVITY MANAGEMENT (DAILY LOG)
// ============================================================

model Activity {
  id               String           @id @default(cuid())
  activityCode     String           @unique
  date             DateTime
  startTime        String?
  endTime          String?
  duration         Int? // in minutes
  title            String
  category         ActivityCategory
  priority         Priority         @default(MEDIUM)
  description      String?
  actionTaken      String?
  assetId          String?
  userId           String?
  departmentId     String?
  vendorId         String?
  status           ActivityStatus   @default(PLANNED)
  followupRequired Boolean          @default(false)
  followupDate     DateTime?
  remarks          String?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  asset       Asset?       @relation(fields: [assetId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  vendor      Vendor?      @relation(fields: [vendorId], references: [id])
  createdBy   User         @relation("ActivityCreator", fields: [createdById], references: [id])
  attachments Attachment[]

  @@index([date])
  @@index([status])
  @@index([category])
  @@index([createdById])
  @@map("activities")
}

model DailyEODSummary {
  id                  String   @id @default(cuid())
  date                DateTime
  userId              String
  totalActivities     Int      @default(0)
  completedCount      Int      @default(0)
  pendingCount        Int      @default(0)
  majorActivities     String?
  issuesEncountered   String?
  completedWork       String?
  pendingItems        String?
  vendorFollowups     String?
  managementFollowups String?
  tomorrowPlan        String?
  totalWorkingHours   Decimal?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([date, userId])
  @@map("daily_eod_summaries")
}

// ============================================================
// TASK MANAGEMENT
// ============================================================

model Task {
  id             String     @id @default(cuid())
  taskCode       String     @unique
  title          String
  description    String?
  category       String?
  priority       Priority   @default(MEDIUM)
  assignedUserId String?
  createdById    String
  startDate      DateTime?
  dueDate        DateTime?
  completedDate  DateTime?
  status         TaskStatus @default(TODO)
  assetId        String?
  vendorId       String?
  departmentId   String?
  ticketId       String?
  remarks        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignedUser User?         @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  createdBy    User          @relation("TaskCreator", fields: [createdById], references: [id])
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  asset        Asset?        @relation(fields: [assetId], references: [id])
  vendor       Vendor?       @relation(fields: [vendorId], references: [id])
  subtasks     TaskSubtask[]
  followups    Followup[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedUserId])
  @@map("tasks")
}

model TaskSubtask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_subtasks")
}

// ============================================================
// TICKET / INCIDENT MANAGEMENT
// ============================================================

model Ticket {
  id                 String         @id @default(cuid())
  ticketNumber       String         @unique
  date               DateTime
  reportedById       String?
  departmentId       String?
  assetId            String?
  category           TicketCategory
  priority           Priority       @default(MEDIUM)
  subject            String
  description        String?
  rootCause          String?
  actionTaken        String?
  resolution         String?
  vendorId           String?
  vendorTicketNumber String?
  downtimeStart      DateTime?
  downtimeEnd        DateTime?
  downtimeDuration   Int? // minutes
  slaHours           Int?
  status             TicketStatus   @default(OPEN)
  assignedEngineerId String?
  closedDate         DateTime?
  remarks            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  reportedBy       User?             @relation("TicketReporter", fields: [reportedById], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  asset            Asset?            @relation(fields: [assetId], references: [id])
  vendor           Vendor?           @relation(fields: [vendorId], references: [id])
  assignedEngineer User?             @relation("TicketEngineer", fields: [assignedEngineerId], references: [id])
  tasks            Task[]
  followups        Followup[]
  attachments      Attachment[]
  networkDowntime  NetworkDowntime[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([date])
  @@map("tickets")
}

// ============================================================
// INVOICES & PAYMENTS
// ============================================================

model Invoice {
  id               String        @id @default(cuid())
  invoiceCode      String        @unique
  invoiceNumber    String
  vendorId         String
  service          String?
  invoiceDate      DateTime
  billingPeriod    String?
  subtotal         Decimal
  gstPercent       Decimal       @default(18)
  gstAmount        Decimal
  totalAmount      Decimal
  dueDate          DateTime?
  approvalStatus   InvoiceStatus @default(DRAFT)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentDate      DateTime?
  paymentReference String?
  remarks          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  payments    Payment[]
  followups   Followup[]
  attachments Attachment[]

  @@index([vendorId])
  @@index([paymentStatus])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id              String   @id @default(cuid())
  paymentCode     String   @unique
  invoiceId       String?
  vendorId        String
  amount          Decimal
  paymentDate     DateTime
  paymentMode     String?
  referenceNumber String?
  description     String?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  vendor  Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([paymentDate])
  @@map("payments")
}

// ============================================================
// ISP / INTERNET MANAGEMENT
// ============================================================

model ISPConnection {
  id             String            @id @default(cuid())
  connectionCode String            @unique
  ispName        String
  vendorId       String?
  connectionId   String?
  locationId     String?
  bandwidth      String?
  connectionType ISPConnectionType
  monthlyCost    Decimal
  gstPercent     Decimal           @default(18)
  billingDate    Int? // day of month
  dueDate        Int? // days after billing date
  publicIp       String?
  routerAssetId  String?
  backupIspId    String?
  sla            String?
  supportNumber  String?
  accountNumber  String?
  status         NetworkStatus     @default(ONLINE)
  isActive       Boolean           @default(true)
  remarks        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  location        Location?         @relation(fields: [locationId], references: [id])
  networkDevices  NetworkDevice[]
  downtimeRecords NetworkDowntime[]

  @@index([status])
  @@map("isp_connections")
}

// ============================================================
// NETWORK MONITORING
// ============================================================

model NetworkDevice {
  id          String            @id @default(cuid())
  deviceCode  String            @unique
  name        String
  deviceType  NetworkDeviceType
  ipAddress   String?
  macAddress  String?
  locationId  String?
  ispId       String?
  brand       String?
  model       String?
  status      NetworkStatus     @default(ONLINE)
  isMonitored Boolean           @default(true)
  remarks     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  location        Location?         @relation(fields: [locationId], references: [id])
  isp             ISPConnection?    @relation(fields: [ispId], references: [id])
  downtimeRecords NetworkDowntime[]

  @@index([status])
  @@map("network_devices")
}

model NetworkDowntime {
  id              String    @id @default(cuid())
  downtimeCode    String    @unique
  deviceId        String?
  ispId           String?
  ticketId        String?
  date            DateTime
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  reason          String?
  resolution      String?
  impact          String?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  device NetworkDevice? @relation(fields: [deviceId], references: [id])
  isp    ISPConnection? @relation(fields: [ispId], references: [id])
  ticket Ticket?        @relation(fields: [ticketId], references: [id])

  @@index([date])
  @@map("network_downtime")
}

// ============================================================
// AMC MANAGEMENT
// ============================================================

model AMCContract {
  id               String           @id @default(cuid())
  amcCode          String           @unique
  vendorId         String
  contractNumber   String?
  serviceType      String
  assetCategory    String?
  startDate        DateTime
  endDate          DateTime
  contractValue    Decimal
  gstPercent       Decimal          @default(18)
  gstAmount        Decimal
  totalValue       Decimal
  paymentTerms     String?
  sla              String?
  serviceFrequency PMFrequency?
  contactPerson    String?
  contactNumber    String?
  lastService      DateTime?
  nextService      DateTime?
  renewalStatus    AMCRenewalStatus @default(ACTIVE)
  documentUrl      String?
  remarks          String?
  alertDays        Int              @default(30)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  assets      Asset[]      @relation("AMCAssets")
  services    AMCService[]
  attachments Attachment[]

  @@index([endDate])
  @@index([renewalStatus])
  @@map("amc_contracts")
}

model AMCService {
  id          String    @id @default(cuid())
  amcId       String
  serviceDate DateTime
  engineerId  String?
  findings    String?
  actionTaken String?
  status      PMStatus  @default(COMPLETED)
  nextService DateTime?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  amc AMCContract @relation(fields: [amcId], references: [id], onDelete: Cascade)

  @@index([amcId])
  @@map("amc_services")
}

// ============================================================
// PREVENTIVE MAINTENANCE
// ============================================================

model PreventiveMaintenance {
  id              String      @id @default(cuid())
  pmCode          String      @unique
  assetId         String?
  assetType       AssetType?
  locationId      String?
  maintenanceType String
  frequency       PMFrequency
  scheduledDate   DateTime
  completedDate   DateTime?
  engineerId      String?
  checklist       String? // JSON array of checklist items
  findings        String?
  actionTaken     String?
  partsReplaced   String?
  downtimeMinutes Int?
  status          PMStatus    @default(SCHEDULED)
  nextPMDate      DateTime?
  remarks         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  asset       Asset?       @relation(fields: [assetId], references: [id])
  engineer    User?        @relation("PMEngineer", fields: [engineerId], references: [id])
  attachments Attachment[]

  @@index([scheduledDate])
  @@index([status])
  @@map("preventive_maintenance")
}

// ============================================================
// SOFTWARE LICENSES
// ============================================================

model SoftwareLicense {
  id            String        @id @default(cuid())
  licenseCode   String        @unique
  softwareName  String
  vendorId      String?
  licenseType   LicenseType
  licenseKey    String?
  totalLicenses Int
  usedLicenses  Int           @default(0)
  purchaseDate  DateTime?
  expiryDate    DateTime?
  cost          Decimal?
  renewalCost   Decimal?
  status        LicenseStatus @default(ACTIVE)
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vendor      Vendor?             @relation(fields: [vendorId], references: [id])
  assignments LicenseAssignment[]

  @@index([expiryDate])
  @@index([status])
  @@map("software_licenses")
}

model LicenseAssignment {
  id         String    @id @default(cuid())
  licenseId  String
  userId     String
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?
  remarks    String?

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@unique([licenseId, userId])
  @@map("license_assignments")
}

// ============================================================
// WARRANTY MANAGEMENT
// ============================================================

model Warranty {
  id             String         @id @default(cuid())
  assetId        String         @unique
  vendorId       String?
  warrantyStart  DateTime
  warrantyEnd    DateTime
  warrantyType   WarrantyType
  supportContact String?
  status         WarrantyStatus @default(ACTIVE)
  remarks        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  asset  Asset           @relation(fields: [assetId], references: [id])
  vendor Vendor?         @relation(fields: [vendorId], references: [id])
  claims WarrantyClaim[]

  @@index([warrantyEnd])
  @@index([status])
  @@map("warranties")
}

model WarrantyClaim {
  id          String    @id @default(cuid())
  warrantyId  String
  claimNumber String?
  claimDate   DateTime
  issue       String
  resolution  String?
  status      String    @default("OPEN")
  closedDate  DateTime?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@map("warranty_claims")
}

// ============================================================
// BACKUP MONITORING
// ============================================================

model BackupJob {
  id           String   @id @default(cuid())
  jobCode      String   @unique
  jobName      String
  serverName   String
  backupType   String
  backupTarget String
  schedule     String
  retention    String?
  isActive     Boolean  @default(true)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs BackupLog[]

  @@map("backup_jobs")
}

model BackupLog {
  id                   String       @id @default(cuid())
  jobId                String
  backupDate           DateTime
  status               BackupStatus
  backupSizeBytes      BigInt?
  lastSuccessfulBackup DateTime?
  errorMessage         String?
  actionTaken          String?
  duration             Int? // seconds
  remarks              String?
  createdAt            DateTime     @default(now())

  job BackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([backupDate])
  @@index([status])
  @@map("backup_logs")
}

// ============================================================
// CCTV MANAGEMENT
// ============================================================

model NVRDevice {
  id            String    @id @default(cuid())
  nvrCode       String    @unique
  name          String
  brand         String?
  model         String?
  ipAddress     String?
  locationId    String?
  totalChannels Int       @default(16)
  status        String    @default("ONLINE")
  lastPingAt    DateTime?
  latencyMs     Int?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  location Location?    @relation(fields: [locationId], references: [id])
  cameras  CCTVCamera[]

  @@map("nvr_devices")
}

model CCTVCamera {
  id               String     @id @default(cuid())
  cameraCode       String     @unique
  name             String
  locationId       String?
  ipAddress        String?
  brand            String?
  model            String?
  nvrId            String?
  channel          Int?
  installationDate DateTime?
  warrantyEnd      DateTime?
  amcEnd           DateTime?
  status           CCTVStatus @default(ONLINE)
  lastMaintenance  DateTime?
  nextMaintenance  DateTime?
  lastPingAt       DateTime?
  latencyMs        Int?
  remarks          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  location Location?  @relation(fields: [locationId], references: [id])
  nvr      NVRDevice? @relation(fields: [nvrId], references: [id])

  @@index([status])
  @@map("cctv_cameras")
}

// ============================================================
// LAPTOP RENTAL
// ============================================================

model LaptopRental {
  id               String              @id @default(cuid())
  rentalCode       String              @unique
  vendorId         String
  assetId          String?
  brand            String?
  model            String?
  serialNumber     String?
  assignedUserId   String?
  assignedUserName String?
  department       String?
  rentalStart      DateTime
  rentalEnd        DateTime?
  monthlyRental    Decimal
  gstPercent       Decimal             @default(18)
  gstAmount        Decimal
  totalMonthly     Decimal
  invoiceNumber    String?
  invoiceDate      DateTime?
  paymentDueDate   DateTime?
  paymentDate      DateTime?
  paymentStatus    RentalPaymentStatus @default(PENDING)
  returnDate       DateTime?
  condition        AssetCondition?
  remarks          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])
  asset  Asset? @relation(fields: [assetId], references: [id])

  @@index([vendorId])
  @@index([paymentStatus])
  @@map("laptop_rentals")
}

// ============================================================
// PROCUREMENT
// ============================================================

model PurchaseRequest {
  id              String         @id @default(cuid())
  prCode          String         @unique
  requestDate     DateTime
  requestedById   String?
  departmentId    String?
  item            String
  category        String?
  quantity        Int            @default(1)
  estimatedCost   Decimal?
  vendorId        String?
  quotationNumber String?
  status          PurchaseStatus @default(REQUEST)
  poNumber        String?
  orderDate       DateTime?
  deliveryDate    DateTime?
  invoiceNumber   String?
  paymentStatus   PaymentStatus  @default(PENDING)
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  requestedBy Department?  @relation(fields: [departmentId], references: [id])
  vendor      Vendor?      @relation(fields: [vendorId], references: [id])
  attachments Attachment[]

  @@index([status])
  @@map("purchase_requests")
}

// ============================================================
// FOLLOW-UP MANAGEMENT
// ============================================================

model Followup {
  id                String            @id @default(cuid())
  followupCode      String            @unique
  subject           String
  description       String?
  vendorId          String?
  ticketId          String?
  invoiceId         String?
  taskId            String?
  assetId           String?
  userId            String?
  assignedToId      String?
  followupDate      DateTime
  nextFollowupDate  DateTime?
  completedDate     DateTime?
  personContacted   String?
  communicationType CommunicationType @default(PHONE)
  priority          Priority          @default(MEDIUM)
  discussion        String?
  actionRequired    String?
  status            FollowupStatus    @default(PENDING)
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  vendor  Vendor?           @relation(fields: [vendorId], references: [id])
  ticket  Ticket?           @relation(fields: [ticketId], references: [id])
  invoice Invoice?          @relation(fields: [invoiceId], references: [id])
  task    Task?             @relation(fields: [taskId], references: [id])
  asset   Asset?            @relation(fields: [assetId], references: [id])
  user    User?             @relation(fields: [userId], references: [id])
  history FollowupHistory[]

  @@index([followupDate])
  @@index([status])
  @@map("followups")
}

model FollowupHistory {
  id               String          @id @default(cuid())
  followupId       String
  note             String
  nextFollowupDate DateTime?
  status           FollowupStatus?
  createdById      String?
  createdAt        DateTime        @default(now())

  followup Followup @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@index([followupId])
  @@map("followup_histories")
}

// ============================================================
// EXPENSE MANAGEMENT
// ============================================================

model ExpenseCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String        @id @default(cuid())
  expenseCode   String        @unique
  categoryId    String?
  vendorId      String?
  description   String
  amount        Decimal
  gstAmount     Decimal       @default(0)
  totalAmount   Decimal
  expenseDate   DateTime
  month         Int
  year          Int
  invoiceNumber String?
  paymentStatus PaymentStatus @default(PENDING)
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id])
  vendor   Vendor?          @relation(fields: [vendorId], references: [id])

  @@index([month, year])
  @@index([vendorId])
  @@map("expenses")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String               @id @default(cuid())
  userId    String?
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  title     String
  message   String
  link      String?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// ATTACHMENTS (Polymorphic)
// ============================================================

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  uploadedAt   DateTime @default(now())

  activities   Activity[]
  tickets      Ticket[]
  invoices     Invoice[]
  amcContracts AMCContract[]
  maintenance  PreventiveMaintenance[]
  purchases    PurchaseRequest[]

  @@map("attachments")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String
  module      String
  recordId    String?
  recordCode  String?
  oldValues   String?
  newValues   String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// KPI TARGETS (Configurable)
// ============================================================

model KPITarget {
  id          String   @id @default(cuid())
  metric      String   @unique
  targetValue Decimal
  unit        String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("kpi_targets")
}
